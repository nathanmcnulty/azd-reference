{
  "$schema": "../schemas/repository-baseline.schema.json",
  "schemaVersion": "1.0",
  "baselineVersion": "2026.08.2",
  "requiredRepositoryFiles": [
    ".gitattributes",
    ".github/dependabot.yml",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "requiredSolutionFiles": [
    "azure.yaml",
    "README.md"
  ],
  "recommendedSolutionFiles": [
    ".azd/catalog.json"
  ],
  "workflowPolicy": {
    "externalActions": "full-commit-sha",
    "defaultPermissions": "contents-read",
    "dependencyUpdates": "grouped-and-bounded"
  }
}
