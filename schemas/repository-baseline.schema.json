{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "azd repository baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "baselineVersion",
    "requiredRepositoryFiles",
    "requiredSolutionFiles",
    "recommendedSolutionFiles",
    "workflowPolicy"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "baselineVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}(?:\\.[0-9]+)?$"
    },
    "requiredRepositoryFiles": {
      "$ref": "#/$defs/pathList"
    },
    "requiredSolutionFiles": {
      "$ref": "#/$defs/pathList"
    },
    "recommendedSolutionFiles": {
      "$ref": "#/$defs/pathList"
    },
    "workflowPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalActions",
        "defaultPermissions",
        "dependencyUpdates"
      ],
      "properties": {
        "externalActions": {
          "const": "full-commit-sha"
        },
        "defaultPermissions": {
          "const": "contents-read"
        },
        "dependencyUpdates": {
          "const": "grouped-and-bounded"
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!\\.{1,2}(?:/|$))(?!.*?/\\.{1,2}(?:/|$))[^\\\\\\u0000-\\u001F]+$"
    },
    "pathList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relativePath"
      }
    }
  }
}
