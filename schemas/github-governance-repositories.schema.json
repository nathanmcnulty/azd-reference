{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "azd GitHub governance repository registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogValidationPolicy",
    "repositories"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "2.1"},
    "catalogValidationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enforcementMode", "workflow", "callerPath", "desiredWorkflowRevision", "requiredStatusCheck"],
      "properties": {
        "enforcementMode": {"enum": ["non-required", "required-enabled"]},
        "workflow": {
          "const": "nathanmcnulty/azd-reference/.github/workflows/catalog-metadata.yml"
        },
        "callerPath": {
          "const": ".github/workflows/catalog-metadata.yml"
        },
        "desiredWorkflowRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "requiredStatusCheck": {
          "type": "object",
          "additionalProperties": false,
          "required": ["context", "integrationId"],
          "properties": {
            "context": {"type": "string", "minLength": 1},
            "integrationId": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/repository"}
    }
  },
  "$defs": {
    "catalogPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000]+$"
    },
    "catalogValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {"enum": ["pending", "pilot", "required", "exempt"]},
        "catalogPath": {"$ref": "#/$defs/catalogPath"},
        "exemptionReason": {"type": "string", "minLength": 1},
        "requiredApproval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approvedBy", "approvedAt", "evidence"],
          "properties": {
            "approvedBy": {"const": "nathanmcnulty"},
            "approvedAt": {"type": "string", "format": "date-time"},
            "evidence": {
              "type": "string",
              "pattern": "^https://github\\.com/nathanmcnulty/azd-reference/(?:issues|pull)/[1-9][0-9]*$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "exempt"}}, "required": ["state"]},
          "then": {"required": ["exemptionReason"]},
          "else": {"not": {"required": ["exemptionReason"]}}
        },
        {
          "if": {"properties": {"state": {"const": "required"}}, "required": ["state"]},
          "then": {"required": ["requiredApproval"]},
          "else": {"not": {"required": ["requiredApproval"]}}
        }
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "defaultBranch", "requiredStatusChecks", "catalogValidation"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}[a-z0-9]$"
        },
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "defaultBranch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "requiredStatusChecks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "releaseTagPattern": {
          "type": "string",
          "pattern": "^refs/tags/.+"
        },
        "catalogValidation": {"$ref": "#/$defs/catalogValidation"}
      }
    }
  }
}
