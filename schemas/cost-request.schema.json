{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "asOf",
    "periodStart",
    "region",
    "currency",
    "users",
    "devices",
    "priorRetentionDays",
    "includeOneTime",
    "allocationScope",
    "selections"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "asOf": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "periodStart": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "region": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9-]{0,59}$"
    },
    "currency": {
      "enum": [
        "USD"
      ]
    },
    "users": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "devices": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "priorRetentionDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3650
    },
    "includeOneTime": {
      "type": "boolean"
    },
    "allocationScope": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9-]{0,59}$"
    },
    "selections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile",
          "configuration"
        ],
        "properties": {
          "profile": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[a-z][a-z0-9-]{0,59}$"
          },
          "configuration": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[a-z][a-z0-9-]{0,59}$"
          }
        }
      },
      "minItems": 1,
      "maxItems": 12
    }
  }
}
