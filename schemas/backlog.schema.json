{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "azd agent backlog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "sourceRevision", "capturedAt", "items"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+$"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "capturedAt": {
      "type": "string",
      "format": "date"
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "textList": {
      "type": "array",
      "items": { "$ref": "#/$defs/text" },
      "uniqueItems": true
    },
    "requiredTextList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/text" },
      "uniqueItems": true
    },
    "itemId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9-]*-[0-9]+$"
    },
    "dependency": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+:)?[A-Za-z][A-Za-z0-9-]*-[0-9]+$"
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "worktree", "baseRevision", "startedAt"],
      "properties": {
        "owner": { "$ref": "#/$defs/text" },
        "worktree": { "$ref": "#/$defs/text" },
        "baseRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "kind",
        "priority",
        "status",
        "wave",
        "problem",
        "scope",
        "acceptance",
        "validation",
        "dependencies",
        "authorization",
        "components",
        "sources",
        "evidence",
        "blocker"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "title": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["verification", "feature", "maintenance", "discovery"] },
        "priority": { "enum": ["P0", "P1", "P2", "P3"] },
        "status": { "enum": ["proposed", "ready", "in-progress", "blocked", "done", "deferred"] },
        "wave": { "type": "integer", "minimum": 0, "maximum": 4 },
        "problem": { "$ref": "#/$defs/text" },
        "scope": { "$ref": "#/$defs/requiredTextList" },
        "acceptance": { "$ref": "#/$defs/requiredTextList" },
        "validation": { "$ref": "#/$defs/requiredTextList" },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/dependency" },
          "uniqueItems": true
        },
        "authorization": {
          "enum": ["local-only", "azure-deployment", "tenant-write", "external-delivery", "publication", "cleanup"]
        },
        "components": { "$ref": "#/$defs/textList" },
        "sources": { "$ref": "#/$defs/textList" },
        "evidence": { "$ref": "#/$defs/textList" },
        "blocker": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/text" }
          ]
        },
        "claim": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/claim" }
          ]
        }
      }
    }
  }
}
