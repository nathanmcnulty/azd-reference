{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azd.nathanmcnulty.com/schemas/catalog.json",
  "title": "azd repository catalog metadata",
  "description": "Optional curated catalog metadata stored at .azd/catalog.json in an eligible azd repository.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "featured": {
      "type": "boolean"
    },
    "solutionCount": {
      "type": "integer",
      "minimum": 1
    },
    "quickstartCommands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
