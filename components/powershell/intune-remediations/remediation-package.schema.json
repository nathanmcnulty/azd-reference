{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intune device health script package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageType", "identityKey", "displayName", "description", "publisher", "version", "detectionScript", "remediationScript", "execution", "assignment", "evidenceBoundary"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "packageType": { "const": "intuneDeviceHealthScript" },
    "identityKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{2,127}$" },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "detectionScript": { "$ref": "#/$defs/script" },
    "remediationScript": { "$ref": "#/$defs/script" },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runAsAccount", "runAs32Bit", "enforceSignatureCheck", "minimumPowerShell"],
      "properties": {
        "runAsAccount": { "const": "system" },
        "runAs32Bit": { "const": false },
        "enforceSignatureCheck": { "const": false },
        "minimumPowerShell": { "const": "5.1" }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runRemediationScript", "schedule"],
      "properties": {
        "runRemediationScript": { "const": false },
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "interval", "useUtc", "time"],
          "properties": {
            "type": { "const": "daily" },
            "interval": { "const": 1 },
            "useUtc": { "const": true },
            "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,7})?$" }
          }
        }
      }
    },
    "evidenceBoundary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byteLength"],
      "properties": {
        "path": { "type": "string", "pattern": "^[^/\\\\].*\\.ps1$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "byteLength": { "type": "integer", "minimum": 1 },
        "behavior": { "type": "string" }
      }
    }
  }
}
